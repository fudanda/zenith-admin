# Copy to .env.go for local development. Production uses environment variables directly.
ARCBASE_DATABASE_URL=postgres://arcbase:CHANGE_ME@127.0.0.1:5432/arcbase?sslmode=disable
# Alternative persistent SQLite database (select one ARCBASE_DATABASE_URL):
# ARCBASE_DATABASE_URL=sqlite:./data/arcbase.db
# SQLite tests use independent temporary files and do not touch the path below:
# ARCBASE_TEST_DATABASE_URL=sqlite:./data/test.db
ARCBASE_TEST_DATABASE_URL=postgres://arcbase:CHANGE_ME@127.0.0.1:5432/arcbase_test?sslmode=disable
ARCBASE_ADDR=127.0.0.1:8080
# Local HTTP only. Remove in production, where HTTPS is required by the Secure cookie.
ARCBASE_INSECURE_COOKIES=true
# S3 credentials require 32 random bytes as 64 hex characters. No default key.
# Back up this stable key separately from the database and upload staging.
# ARCBASE_STORAGE_KEY=
# Persistent upload staging and encrypted S3 compensation journal.
# ARCBASE_FILE_STAGING_PATH=D:/arcbase-data/uploads
# Integration tests also require an isolated S3-compatible service.
# ARCBASE_TEST_S3_ENDPOINT=http://127.0.0.1:19000
# ARCBASE_TEST_S3_ACCESS_KEY=
# ARCBASE_TEST_S3_SECRET_KEY=
