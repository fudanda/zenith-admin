# Copy to .env.go for local development. Production uses environment variables directly.
ZENITH_DATABASE_URL=postgres://zenith:CHANGE_ME@127.0.0.1:5432/zenith?sslmode=disable
# Alternative persistent SQLite database (select one ZENITH_DATABASE_URL):
# ZENITH_DATABASE_URL=sqlite:./data/zenith.db
# SQLite tests use independent temporary files and do not touch the path below:
# ZENITH_TEST_DATABASE_URL=sqlite:./data/test.db
ZENITH_TEST_DATABASE_URL=postgres://zenith:CHANGE_ME@127.0.0.1:5432/zenith_test?sslmode=disable
ZENITH_ADDR=127.0.0.1:8080
# Local HTTP only. Remove in production, where HTTPS is required by the Secure cookie.
ZENITH_INSECURE_COOKIES=true
# S3 credentials require 32 random bytes as 64 hex characters. No default key.
# Back up this stable key separately from the database and upload staging.
# ZENITH_STORAGE_KEY=
# Persistent upload staging and encrypted S3 compensation journal.
# ZENITH_FILE_STAGING_PATH=D:/zenith-data/uploads
# Integration tests also require an isolated S3-compatible service.
# ZENITH_TEST_S3_ENDPOINT=http://127.0.0.1:19000
# ZENITH_TEST_S3_ACCESS_KEY=
# ZENITH_TEST_S3_SECRET_KEY=
