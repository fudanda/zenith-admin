# Copy to .env.go for local development. Production uses environment variables directly.
ZENITH_DATABASE_URL=postgres://zenith:CHANGE_ME@127.0.0.1:5432/zenith?sslmode=disable
ZENITH_TEST_DATABASE_URL=postgres://zenith:CHANGE_ME@127.0.0.1:5432/zenith_test?sslmode=disable
ZENITH_ADDR=127.0.0.1:8080
# Local HTTP only. Remove in production, where HTTPS is required by the Secure cookie.
ZENITH_INSECURE_COOKIES=true
