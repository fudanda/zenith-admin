{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": "../..",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@zenith/admin-client": ["packages/client/src/index.ts"],
      "@zenith/admin-core": ["packages/admin-core/src/index.tsx"],
      "@zenith/admin-modules": ["packages/admin-modules/src/index.ts"],
      "@zenith/admin-pages": ["packages/admin-pages/src/index.ts"],
      "@zenith/admin-ui": ["packages/admin-ui/src/index.tsx"],
      "@zenith/admin-app": ["packages/admin-app/src/index.tsx"]
    }
  },
  "include": ["src", "../../packages/client/src", "../../packages/admin-core/src", "../../packages/admin-modules/src", "../../packages/admin-pages/src", "../../packages/admin-ui/src", "../../packages/admin-app/src"]
}
