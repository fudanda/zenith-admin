{
  "name": "@arcbase/elements",
  "version": "2.58.0",
  "private": true,
  "type": "module",
  "description": "Composable ArcBase session, login, permission, avatar and file elements.",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/clean-declarations.mjs",
    "check:types": "tsc -b",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "build:example": "vite build --config examples/vite.config.ts"
  },
  "peerDependencies": {
    "@arcbase/client": "^2.58.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@douyinfe/semi-ui": "^2.103.0"
  },
  "dependencies": {
    "@arcbase/shared": "^2.58.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "vite": "^8.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
