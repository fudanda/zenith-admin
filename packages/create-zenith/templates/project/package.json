{
  "name": "zenith-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs && node scripts/go.mjs generate",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "build:frontend": "tsc --noEmit && node scripts/build-frontend.mjs",
    "build": "npm run generate && npm run build:frontend && node scripts/build-backend.mjs",
    "dev": "concurrently \"node scripts/go.mjs serve\" \"vite --config vite.config.ts\"",
    "start": "node scripts/run.mjs serve",
    "db:migrate": "node scripts/go.mjs migrate",
    "db:seed": "node scripts/go.mjs seed",
    "init-admin": "node scripts/go.mjs init-admin",
    "reset-admin": "node scripts/go.mjs reset-admin",
    "check": "node scripts/go.mjs check",
    "version": "node scripts/go.mjs version",
    "backup": "node scripts/go.mjs backup",
    "restore": "node scripts/go.mjs restore",
    "test": "node scripts/go.mjs test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@douyinfe/semi-ui": "^2.103.0",
    "@douyinfe/semi-icons": "^2.103.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "concurrently": "^10.0.5",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@types/node": "^24.0.0"
  }
}
