# Production binary reads environment variables; load these through your service manager.
ARCBASE_DATABASE_URL=postgres://arcbase:CHANGE_ME@127.0.0.1:5432/arcbase?sslmode=require
# Alternative for a single-host deployment. Use an absolute persistent path:
# ARCBASE_DATABASE_URL=sqlite:/var/lib/arcbase/arcbase.db
ARCBASE_ADDR=127.0.0.1:8080
# HTTPS is required. Secure cookies are enabled by default.
# S3 requires a stable 32-byte random encryption key (64 hex characters).
# ARCBASE_STORAGE_KEY=
# Persist staging and encrypted pending-object cleanup along with file backups.
# ARCBASE_FILE_STAGING_PATH=/var/lib/arcbase/uploads
